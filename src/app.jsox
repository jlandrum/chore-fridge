import { $setupDone } from "./stores/family.js";
import { $ui } from "./stores/navigation.js";
import { tick } from "./stores/clock.js";
import { pullServer, $serverMode } from "./stores/sync.js";
import { defineComponent } from "@js-ox/web-components";
import { computed } from "nanostores";
import { applyTheme } from "./view.js";
import "./views/setup.jsox";
import "./views/board.jsox";
import "./views/pin.jsox";
import "./views/parent.jsox";

const $screen = computed([$setupDone, $ui], (setupDone, navigation) =>
  setupDone ? navigation.view : "setup"
);

[defineComponent("chore-fridge")] {
  .connected = function () {
    if (!this.children.length) {
      this.id = "app";
      [this] {
        <fridge-setup> { .hidden = true }
        <fridge-board> { .hidden = true }
        <fridge-pin> { .hidden = true }
        <fridge-parent> { .hidden = true }
      }
    }
    this.unsubscribe = $screen.subscribe((current) => {
      for (const screen of this.children) {
        screen.hidden = screen.localName !== "fridge-" + current;
        if (!screen.hidden) screen.syncDOM();
      }
    });
    pullServer();
    this.pollTimer = setInterval(() => {
      applyTheme();
      if ($serverMode.get() && $ui.get().view === "board") pullServer();
    }, 5000);
    this.dayTimer = setInterval(tick, 60000);
  }
  .disconnected = function () {
    this.unsubscribe();
    clearInterval(this.pollTimer);
    clearInterval(this.dayTimer);
  }
  .register()
}
