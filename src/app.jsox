import { defineComponent } from "@js-ox/web-components";
import { state, ui, pullServer, serverMode } from "./state.js";
import { applyTheme } from "./view.js";
import { subscribe, paint } from "./bus.js";
import "./views/setup.jsox";
import "./views/board.jsox";
import "./views/pin.jsox";
import "./views/parent.jsox";

[defineComponent("chore-fridge")] {
  .connected = function () {
    if (!this.children.length) {
      this.id = "app";
      [this] {
        <fridge-setup> { .hidden = true }
        <fridge-board> { .hidden = true }
        <fridge-pin> { .hidden = true }
        <fridge-parent> { .hidden = true }
      }
    }
    const update = () => {
      applyTheme();
      const current = state.setupDone ? ui.view : "setup";
      for (const screen of this.children) {
        screen.hidden = screen.localName !== "fridge-" + current;
        if (!screen.hidden) screen.update();
      }
    };
    this.unsubscribe = subscribe(update);
    update();
    pullServer(paint);
    this.pollTimer = setInterval(() => {
      applyTheme();
      if (serverMode && ui.view === "board") pullServer(paint);
    }, 5000);
    this.dayTimer = setInterval(() => {
      if (ui.view === "board" && state.setupDone) paint();
    }, 60000);
  }
  .disconnected = function () {
    this.unsubscribe();
    clearInterval(this.pollTimer);
    clearInterval(this.dayTimer);
  }
  .register()
}
