import { state, ui, persist } from "../state.js";
import { paint } from "../bus.js";
import { Btn, showToast } from "../ui.jsox";

function submitPin() {
  if (ui.pinMode === "set") {
    if (ui.pinBuf.length !== 4) {
      showToast("Need 4 digits");
      return;
    }
    state.pin = ui.pinBuf;
    persist();
    ui.pinBuf = "";
    ui.view = "parent";
    showToast("PIN saved");
    paint();
    return;
  }
  if (ui.pinBuf === state.pin) {
    ui.pinBuf = "";
    ui.view = "parent";
    paint();
  } else {
    ui.pinBuf = "";
    showToast("Nope");
    paint();
  }
}

function onKey(k) {
  if (k === "←") ui.pinBuf = ui.pinBuf.slice(0, -1);
  else if (k === "OK") {
    submitPin();
    return;
  } else if (ui.pinBuf.length < 4) ui.pinBuf += String(k);

  if (ui.pinBuf.length === 4 && k !== "OK" && k !== "←") submitPin();
  else paint();
}

export function createPin() {
  const lead = <p> { .className = "lead" }
  const dots = [];
  const dotsRow = <div> { .className = "dots" }
  for (let i = 0; i < 4; i++) {
    const dot = <span> {}
    dots.push(dot);
    [dotsRow] { [dot] }
  }
  const pad = <div> { .className = "pad" }
  for (const k of [1, 2, 3, 4, 5, 6, 7, 8, 9, "←", 0, "OK"]) {
    [pad] {
      <button> {
        .type = "button"
        [String(k)]
        .onclick = () => onKey(k)
      }
    }
  }
  const root = <div> {
    .className = "panel"
    <h2> { ["Parent lock"] }
    [lead]
    [dotsRow]
    [pad]
    <div> {
      .className = "row"
      .style.marginTop = "18px"
      [Btn("Back to board", "btn ghost wide", () => {
        ui.view = "board";
        ui.pinBuf = "";
        paint();
      })]
    }
  }

  function sync() {
    lead.textContent = ui.pinMode === "set" ? "Choose a 4-digit PIN." : "Enter the parent PIN.";
    dots.forEach((dot, i) => {
      dot.className = i < ui.pinBuf.length ? "full" : "";
    });
  }

  return { root, sync };
}
