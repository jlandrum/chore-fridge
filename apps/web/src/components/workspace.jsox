import { atom } from "nanostores";
import { $kids } from "../stores/family.js";
import { $rewards } from "../stores/rewards.js";
import { $view, getView } from "../view.js";
import { defineScreen } from "./screen.jsox";
import { updateList } from "./list.js";
import { Shop } from "./shop.jsox";
import { Dock } from "./dock.jsox";
import "./kid.jsox";

export const $compactOnStore = atom(false);
let compactIndex = 0;
let applyCompactPage = () => {};

export function goCompactStore() {
  compactIndex = $kids.get().length;
  $compactOnStore.set(true);
  applyCompactPage();
}

export function goCompactHome() {
  compactIndex = 0;
  $compactOnStore.set(false);
  applyCompactPage();
}

defineScreen("fridge-workspace", (root) => {
  const boardEl = <section> { .className = "board" }
  const shopEl = Shop()
  const dockEl = Dock()
  const goShop = <button> {
    .type = "button"
    .className = "slide-arrow slide-go-shop"
    .setAttribute("aria-label", "Open the shop")
    ["›"]
  }
  const goBoard = <button> {
    .type = "button"
    .className = "slide-arrow slide-go-board"
    .setAttribute("aria-label", "Back to chores")
    ["‹"]
  }
  const emptyBoard = <div> {
    .className = "panel"
    <h2> { ["No kids yet"] }
    <p> { .className = "lead"; ["Tap the family name for Parent Mode, then open Settings to add your family."] }
  }
  [root] {
    .className = "workspace"
    <div> { .className = "stage"; [boardEl]; [shopEl] }
    [goShop]
    [goBoard]
    [dockEl]
  }

  let shopOpen = false;
  let startX = 0;
  let startY = 0;
  let tracking = false;

  function layout() {
    return getView().layout || "classic";
  }

  function compactCards() {
    return [...boardEl.querySelectorAll("fridge-kid")];
  }

  function showCompact(index) {
    const cards = compactCards();
    const pages = cards.length + 1;
    compactIndex = Math.max(0, Math.min(index, Math.max(0, pages - 1)));
    const onStore = compactIndex >= cards.length;
    cards.forEach((card, i) => card.classList.toggle("is-current", !onStore && i === compactIndex));
    shopEl.classList.toggle("is-current", onStore);
    $compactOnStore.set(onStore);
    if (onStore && shopEl.syncDOM) shopEl.syncDOM();
  }

  applyCompactPage = () => {
    if (layout() === "compact") showCompact(compactIndex);
  };

  function applyLayout() {
    const mode = layout();
    root.classList.toggle("shop-open", mode === "slide" && shopOpen);
    shopEl.hidden = mode === "classic";
    goShop.hidden = mode !== "slide" || shopOpen;
    goBoard.hidden = mode !== "slide" || !shopOpen;
    dockEl.hidden = mode !== "classic" || !$rewards.get().length;
    if (mode !== "compact") {
      shopEl.classList.remove("is-current");
      compactCards().forEach((card) => {
        if (card.classList.contains("is-current")) card.classList.remove("is-current");
      });
      if ($compactOnStore.get()) $compactOnStore.set(false);
    } else showCompact(compactIndex);
    if (!shopEl.hidden && shopEl.syncDOM) shopEl.syncDOM();
    if (!dockEl.hidden && dockEl.syncDOM) dockEl.syncDOM();
  }

  function showShop() {
    if (layout() !== "slide") return;
    shopOpen = true;
    applyLayout();
  }

  function showBoard() {
    shopOpen = false;
    applyLayout();
  }

  goShop.onclick = showShop;
  goBoard.onclick = showBoard;

  root.addEventListener("pointerdown", (event) => {
    const mode = layout();
    if (mode !== "slide" && mode !== "compact") return;
    tracking = true;
    startX = event.clientX;
    startY = event.clientY;
  });
  root.addEventListener("pointerup", (event) => {
    if (!tracking) return;
    tracking = false;
    const mode = layout();
    const dx = event.clientX - startX;
    const dy = event.clientY - startY;
    if (Math.abs(dx) < 72 || Math.abs(dx) < Math.abs(dy) * 1.4) return;
    if (mode === "slide") {
      if (dx < 0) showShop();
      else showBoard();
      return;
    }
    if (mode === "compact") showCompact(compactIndex + (dx < 0 ? 1 : -1));
  });
  root.addEventListener("pointercancel", () => { tracking = false; });

  return [
    [[$kids], () => {
      emptyBoard.remove();
      updateList(boardEl, $kids.get(), "fridge-kid");
      if (!$kids.get().length) boardEl.append(emptyBoard);
      if (layout() === "compact") showCompact(compactIndex);
    }],
    [[$rewards, $view], () => {
      if (layout() !== "slide") shopOpen = false;
      applyLayout();
    }],
  ];
});

export function Workspace() { return <fridge-workspace> }
