import { modal, showToast } from "../ui.jsox";

function dataSource() {
  return new URL("emoji-data.json", document.baseURI).href;
}

export function EmojiField(initial, fallback, label) {
  let value = (initial && String(initial).trim()) || "";
  const placeholder = fallback || "😀";
  const trigger = <button> {
    .type = "button"
    .className = "emoji-trigger"
    .setAttribute("aria-label", label || "Choose emoji")
    .setAttribute("aria-expanded", "false")
    .setAttribute("aria-haspopup", "dialog")
    [value || placeholder]
  }
  const panel = <div> { .className = "emoji-popover" }
  const overlay = <div> {
    .className = "emoji-overlay"
    .hidden = true
    .tabIndex = -1
    .setAttribute("role", "dialog")
    .setAttribute("aria-label", "Choose emoji")
    .onclick = (event) => {
      if (event.target === overlay) setOpen(false);
    }
    .onkeydown = (event) => {
      if (event.key === "Escape") {
        event.stopPropagation();
        setOpen(false);
        trigger.focus();
      }
    }
    [panel]
  }
  let picker = null;
  let open = false;

  function setOpen(next) {
    open = next;
    overlay.hidden = !next;
    trigger.classList.toggle("on", next);
    trigger.setAttribute("aria-expanded", String(next));
    if (next) {
      const host = trigger.closest(".modal, .settings-modal") || modal;
      if (overlay.parentNode !== host) host.append(overlay);
      overlay.focus();
    }
  }

  trigger.onclick = async () => {
    if (open) {
      setOpen(false);
      return;
    }
    try {
      await import("emoji-picker-element");
    } catch {
      showToast("Could not open the emoji picker");
      return;
    }
    if (!picker) {
      picker = document.createElement("emoji-picker");
      picker.dataSource = dataSource();
      picker.addEventListener("emoji-click", (event) => {
        const unicode = event.detail && event.detail.unicode;
        if (!unicode) return;
        value = unicode;
        trigger.textContent = unicode;
        setOpen(false);
        trigger.focus();
      });
      panel.append(picker);
    }
    const night = document.documentElement.classList.contains("night");
    picker.classList.toggle("dark", night);
    picker.classList.toggle("light", !night);
    setOpen(true);
  };

  return {
    trigger,
    get value() { return value || placeholder; },
    set value(next) {
      value = (next && String(next).trim()) || "";
      trigger.textContent = value || placeholder;
    },
  };
}
