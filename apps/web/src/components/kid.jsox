import { $chores, $completions, $counts, isDone, choresForKid } from "../stores/chores.js";
import { $balances, amountForKid } from "../stores/balances.js";
import { $currencies } from "../stores/family.js";
import { enabledCurrencies } from "@chore-fridge/domain/currencies";
import { $clock } from "../stores/clock.js";
import { $view, isDark, writePalette } from "../view.js";
import { defineScreen } from "./screen.jsox";
import { updateList } from "./list.js";
import { CurrencyMark } from "../ui.jsox";
import "./chore.jsox";

defineScreen("fridge-kid", (root) => {
  let kid = root.model;
  const emojiEl = <span> { .className = "emoji" }
  const nameEl = <span> {}
  const metaEl = <div> { .className = "kid-meta" }
  const barEl = <span> {}
  const list = <div> { .className = "chores" }
  const empty = <div> { .className = "empty" }
  [root] {
    .setAttribute("role", "article")
    .className = "kid"
    <div> {
      .className = "kid-head"
      <div> {
        .className = "kid-name"
        [emojiEl]
        [nameEl]
      }
      [metaEl]
    }
    <div> {
      .className = "progress"
      [barEl]
    }
    [list]
  }

  return () => {
    kid = root.model;
    root.style.setProperty("--kid", kid.color);
    writePalette(root, "kid", kid.color, isDark());
    emojiEl.textContent = kid.emoji;
    nameEl.textContent = kid.name;
    const chores = choresForKid(kid.id);
    const done = chores.filter((chore) => isDone(chore, kid.id)).length;
    empty.remove();
    updateList(list, chores, "fridge-chore", (chore) => ({ chore, kid }));
    if (!chores.length) {
      empty.replaceChildren();
      empty.append("Nothing on the list yet.");
      list.append(empty);
    } else if (done === chores.length) {
      empty.replaceChildren();
      const star = <span> { .className = "big"; ["🌟"] }
      empty.append(star, "All done!");
      list.append(empty);
    } else {
      empty.remove();
    }
    const pct = chores.length ? Math.round((done / chores.length) * 100) : 100;
    metaEl.replaceChildren();
    for (const currency of enabledCurrencies($currencies.get())) {
      if (metaEl.childNodes.length) metaEl.append(" · ");
      metaEl.append(CurrencyMark(currency.id), " " + amountForKid(kid.id, currency.id));
    }
    metaEl.append(" · " + done + "/" + chores.length);
    barEl.style.width = pct + "%";
  };
}, [$chores, $completions, $counts, $balances, $currencies, $clock, $view]);
