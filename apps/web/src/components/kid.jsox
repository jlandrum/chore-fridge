import { $chores, $completions, $counts, isDone, choresForKid } from "../stores/chores.js";
import { $balances, amountForKid } from "../stores/balances.js";
import { $currencies } from "../stores/family.js";
import { enabledCurrencies } from "@chore-fridge/domain/currencies";
import { $clock } from "../stores/clock.js";
import { $view, isDark, writePalette } from "../view.js";
import { defineScreen } from "./screen.jsox";
import { updateList } from "./list.js";
import { CurrencyMark } from "../ui.jsox";
import "./chore.jsox";

defineScreen("fridge-kid", (root) => {
  let kid = root.model;
  const emojiEl = <span> { .className = "emoji" }
  const nameEl = <span> {}
  const metaEl = <div> { .className = "kid-meta" }
  const currencyEntries = new Map();
  const completionEl = <span> { .className = "kid-completion" }
  const barEl = <span> {}
  const list = <div> { .className = "chores" }
  const empty = <div> { .className = "empty" }
  [root] {
    .setAttribute("role", "article")
    .className = "kid"
    <div> {
      .className = "kid-head"
      <div> {
        .className = "kid-name"
        [emojiEl]
        [nameEl]
      }
      [metaEl]
    }
    <div> {
      .className = "progress"
      [barEl]
    }
    [list]
  }

  return () => {
    kid = root.model;
    root.style.setProperty("--kid", kid.color);
    writePalette(root, "kid", kid.color, isDark());
    emojiEl.textContent = kid.emoji;
    nameEl.textContent = kid.name;
    const chores = choresForKid(kid.id);
    const done = chores.filter((chore) => isDone(chore, kid.id)).length;
    empty.remove();
    updateList(list, chores, "fridge-chore", (chore) => ({ chore, kid }));
    if (!chores.length) {
      empty.replaceChildren();
      empty.append("Nothing on the list yet.");
      list.append(empty);
    } else if (done === chores.length) {
      empty.replaceChildren();
      const star = <span> { .className = "big"; ["🌟"] }
      empty.append(star, "All done!");
      list.append(empty);
    } else {
      empty.remove();
    }
    const pct = chores.length ? Math.round((done / chores.length) * 100) : 100;
    const currencies = enabledCurrencies($currencies.get());
    const enabledIds = new Set(currencies.map(currency => currency.id));
    for (const [id, entry] of currencyEntries) {
      if (!enabledIds.has(id)) entry.node.remove();
    }
    for (const currency of currencies) {
      let entry = currencyEntries.get(currency.id);
      if (!entry) {
        const mark = CurrencyMark(currency.id);
        const amount = document.createTextNode("");
        const node = <span> { .className = "kid-balance"; [mark]; [amount] }
        entry = { node, mark, amount };
        currencyEntries.set(currency.id, entry);
      }
      if (currency.id === "custom1" || currency.id === "custom2") entry.mark.textContent = currency.emoji || "●";
      entry.amount.textContent = String(amountForKid(kid.id, currency.id));
      entry.node.setAttribute("aria-label", currency.name + ": " + entry.amount.textContent);
      const index = currencies.indexOf(currency);
      if (metaEl.children[index] !== entry.node) metaEl.insertBefore(entry.node, metaEl.children[index] || null);
    }
    completionEl.textContent = done + "/" + chores.length;
    completionEl.setAttribute("aria-label", done + " of " + chores.length + " chores complete");
    if (metaEl.lastChild !== completionEl) metaEl.append(completionEl);
    barEl.style.width = pct + "%";
  };
}, [$chores, $completions, $counts, $balances, $currencies, $clock, $view]);
