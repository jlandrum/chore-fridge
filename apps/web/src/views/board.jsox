import { $familyName } from "../stores/family.js";
import { $chores } from "../stores/chores.js";
import { $balances, familyStars, familyGold } from "../stores/balances.js";
import { $rewards } from "../stores/rewards.js";
import { $ui, openParent, lockParent, openSettings } from "../stores/navigation.js";
import { $clock } from "../stores/clock.js";
import { prettyDate } from "@chore-fridge/domain/dates";
import { defineScreen } from "../components/screen.jsox";
import { Workspace } from "../components/workspace.jsox";
import { Star, Btn } from "../ui.jsox";
import { createViewButton } from "./view-options.jsox";

defineScreen("fridge-board", (root) => {
  const titleEl = <h1> {}
  const dateEl = <div> { .className = "date" }
  const starsNum = <span> {}
  const goldNum = <span> {}
  const starsEl = <div> {
    .className = "pill stars-pill"
    [Star(false)]
    [" "]
    [starsNum]
  }
  const goldEl = <div> {
    .className = "pill gold-pill"
    [Star(true)]
    [" "]
    [goldNum]
  }
  const parentButton = Btn("Unlock Parent Mode", "pill", () => $ui.get().parentUnlocked ? lockParent() : openParent());
  const settingsButton = Btn("Settings", "pill settings-button", openSettings);
  [root] {
    .className = "screen"
    <header> {
      .className = "top"
      <div> {
        .className = "brand"
        [titleEl]
        [dateEl]
      }
      <div> {
        .className = "top-actions"
        [starsEl]
        [goldEl]
        [createViewButton()]
        [parentButton]
        [settingsButton]
      }
    }
    [Workspace()]
  }

  return [
    [[$ui], () => {
      const unlocked = $ui.get().parentUnlocked;
      parentButton.textContent = unlocked ? "Lock Parent Mode" : "Unlock Parent Mode";
      settingsButton.hidden = !unlocked;
    }],
    [[$familyName], () => { titleEl.textContent = $familyName.get(); }],
    [[$clock], () => { dateEl.textContent = prettyDate(); }],
    [[$balances, $chores, $rewards], () => {
      starsNum.textContent = familyStars();
      const gold = familyGold();
      goldNum.textContent = gold;
      goldEl.hidden = !(gold > 0 || $chores.get().some((chore) => chore.gold) || $rewards.get().some((reward) => reward.gold));
    }],
  ];
});
