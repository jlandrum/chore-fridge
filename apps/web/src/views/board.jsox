import { $familyName, $currencies } from "../stores/family.js";
import { $balances, familyAmount } from "../stores/balances.js";
import { enabledCurrencies } from "@chore-fridge/domain/currencies";
import { $ui, openParent, lockParent, openSettings } from "../stores/navigation.js";
import { $boardDay, $clock, shiftBoardDay, showTodayBoard } from "../stores/clock.js";
import { parseDay, prettyDate, todayKey } from "@chore-fridge/domain/dates";
import { defineScreen } from "../components/screen.jsox";
import { Workspace } from "../components/workspace.jsox";
import { Btn, CurrencyMark } from "../ui.jsox";
import { createViewButton } from "./view-options.jsox";

defineScreen("fridge-board", (root) => {
  const titleEl = <h1> {}
  const dateEl = <div> { .className = "date" }
  const nextDay = Btn("Next", "btn ghost board-day-btn", () => shiftBoardDay(1));
  const todayBtn = Btn("Today", "btn ghost board-day-btn", showTodayBoard);
  const dayNav = <div> {
    .className = "board-day"
    [Btn("Prev", "btn ghost board-day-btn", () => shiftBoardDay(-1))]
    [dateEl]
    [nextDay]
    [todayBtn]
  }
  const totalsEl = <div> { .className = "top-balances" }
  const parentButton = Btn("Unlock Parent Mode", "pill", () => $ui.get().parentUnlocked ? lockParent() : openParent());
  const settingsButton = Btn("Settings", "pill settings-button", openSettings);
  [root] {
    .className = "screen"
    <header> {
      .className = "top"
      <div> {
        .className = "brand"
        [titleEl]
        [dayNav]
      }
      <div> {
        .className = "top-actions"
        [totalsEl]
        [createViewButton()]
        [parentButton]
        [settingsButton]
      }
    }
    [Workspace()]
  }

  return [
    [[$ui], () => {
      const unlocked = $ui.get().parentUnlocked;
      parentButton.textContent = unlocked ? "Lock Parent Mode" : "Unlock Parent Mode";
      settingsButton.hidden = !unlocked;
    }],
    [[$familyName], () => { titleEl.textContent = $familyName.get(); }],
    [[$clock, $boardDay], () => {
      const day = $boardDay.get();
      const date = parseDay(day) || new Date();
      dateEl.textContent = prettyDate(date);
      dateEl.dataset.day = day;
      nextDay.disabled = day >= todayKey();
      todayBtn.hidden = day === todayKey();
    }],
    [[$balances, $currencies], () => {
      totalsEl.replaceChildren();
      for (const currency of enabledCurrencies($currencies.get())) {
        const amount = familyAmount(currency.id);
        const pill = <div> { .className = "pill" + (currency.id === "gold" ? " gold-pill" : " stars-pill") }
        pill.append(CurrencyMark(currency.id), " " + amount);
        totalsEl.append(pill);
      }
    }],
  ];
});
