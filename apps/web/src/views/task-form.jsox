import { $kids } from "../stores/family.js";
import { isOnce, isWeekly, saveChore } from "../stores/chores.js";

import { Choices } from "../components/choices.jsox";
import { EmojiField } from "../components/emoji-field.jsox";
import { Btn, showToast, openModal, closeModal } from "../ui.jsox";

export function openTaskForm(opts = {}) {
  const existing = opts.existing || null;
  let repeat = existing
    ? (isOnce(existing) ? "once" : isWeekly(existing) ? "weekly" : "daily")
    : (opts.repeat || "once");
  let kidIds = existing
    ? existing.kidIds.slice()
    : (opts.kidIds && opts.kidIds.length ? opts.kidIds.slice() : $kids.get().map((k) => k.id));

  if (!$kids.get().length) {
    showToast("Add a kid first");
    return;
  }

  const titleInput = <input> {
    .value = existing ? existing.title : ""
    .placeholder = "What needs doing?"
    .autocomplete = "off"
  }
  const emoji = EmojiField(existing && existing.emoji, "😀");
  const pointsInput = <input> {
    .value = existing ? String(existing.points || 0) : "5"
    .autocomplete = "off"
    .inputMode = "numeric"
  }
  const minInput = <input> {
    .value = existing ? String(existing.minCount || 1) : "1"
    .autocomplete = "off"
    .inputMode = "numeric"
  }
  const maxInput = <input> {
    .value = existing ? String(existing.maxCount || 1) : "1"
    .autocomplete = "off"
    .inputMode = "numeric"
  }
  let gold = !!(existing && existing.gold);
  const goldInput = <input> {
    .type = "checkbox"
    .checked = gold
    .setAttribute("role", "switch")
    .setAttribute("aria-label", "Gold star task")
    .setAttribute("aria-checked", String(gold))
    .onchange = () => {
      gold = goldInput.checked;
      goldInput.setAttribute("aria-checked", String(gold));
      goldStatus.textContent = gold ? "On" : "Off";
    }
  }
  const goldStatus = <span> {
    .className = "setting-status"
    .setAttribute("aria-hidden", "true")
    [gold ? "On" : "Off"]
  }

  const repeats = Choices([
    { value: "daily", label: "🔁 Every day" },
    { value: "weekly", label: "📅 Once a week" },
    { value: "once", label: "📌 Just once" },
  ], repeat, (value) => { repeat = value; }, { className: "row task-repeat" });
  const who = Choices(
    $kids.get().map((kid) => ({ value: kid.id, label: kid.emoji + " " + kid.name })),
    kidIds, (value) => { kidIds = value; }, { multiple: true }
  );

  const sheet = <div> {
    .className = "task-form"
    <h3> { [existing ? "Edit task" : "Add a task"] }
    <div> {
      .className = "task-form-fields"
      <div> {
        .className = "row identity-row"
        <div> {
          .className = "field task-title"
          <label> { ["Task"] }
          [titleInput]
        }
        <div> {
          .className = "field task-emoji"
          <label> { ["Emoji"] }
          [emoji.trigger]
        }
      }
      <div> {
        .className = "task-section"
        <p> { .className = "view-label"; ["How often"] }
        [repeats]
      }
      <div> {
        .className = "task-section"
        <p> { .className = "view-label"; ["Who"] }
        [who]
      }
      <div> {
        .className = "field"
        <label> { ["Stars each time"] }
        [pointsInput]
      }
      <div> {
        .className = "field"
        <label> { ["Times per day"] }
        <div> {
          .className = "task-counts"
          <div> {
            .className = "field"
            <label> { ["At least"] }
            [minInput]
          }
          <div> {
            .className = "field"
            <label> { ["Up to"] }
            [maxInput]
          }
        }
        <p> { .className = "field-hint"; ["Both 1 is a single check-off. Raise the second number if they can do it more than once."] }
      }
      <div> {
        .className = "settings-stack"
        <label> {
          .className = "setting-toggle"
          [goldInput]
          <span> {
            .className = "setting-copy"
            <strong> { .className = "setting-title"; ["Gold star task"] }
            <span> { .className = "setting-description"; ["Gold border, and they earn a gold star each time."] }
          }
          <span> {
            .className = "setting-control"
            [goldStatus]
            <span> { .className = "switch-track"; .setAttribute("aria-hidden", "true") }
          }
        }
      }
    }
    <div> {
      .className = "row task-form-actions"
      [Btn("Cancel", "btn ghost wide", closeModal)]
      [Btn("Save", "btn wide", () => {
        const title = titleInput.value.trim();
        if (!title) {
          showToast("Name the task");
          return;
        }
        if (!kidIds.length) {
          showToast("Pick at least one kid");
          return;
        }
        saveChore({
          id: existing ? existing.id : undefined,
          title,
          emoji: emoji.value,
          repeat,
          kidIds,
          points: parseInt(pointsInput.value, 10) || 0,
          minCount: parseInt(minInput.value, 10) || 1,
          maxCount: parseInt(maxInput.value, 10) || 1,
          gold,
        });
        closeModal();
      })]
    }
  }
  openModal(sheet);
  if (!existing) titleInput.focus();
}
