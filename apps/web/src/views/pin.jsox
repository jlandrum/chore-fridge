import { $pin, setPin } from "../stores/family.js";
import { $ui, setUI, unlockParent, openSettings } from "../stores/navigation.js";
import { defineScreen } from "../components/screen.jsox";
import { Btn, showToast } from "../ui.jsox";
import { createViewButton } from "./view-options.jsox";

function submitPin() {
  if ($ui.get().pinMode === "set") {
    if (!$ui.get().parentUnlocked) return;
    if ($ui.get().pinBuf.length !== 4) {
      showToast("Enter a 4-digit PIN.");
      return;
    }
    setPin($ui.get().pinBuf);
    unlockParent();
    openSettings();
    showToast("PIN saved.");
    return;
  }
  if ($ui.get().pinBuf === $pin.get()) {
    unlockParent();
  } else {
    setUI({ pinBuf: "" });
    showToast("Incorrect PIN. Please try again.");
  }
}

function onKey(k) {
  if (k === "←") setUI({ pinBuf: $ui.get().pinBuf.slice(0, -1) });
  else if (k === "OK") {
    submitPin();
    return;
  } else if ($ui.get().pinBuf.length < 4) setUI({ pinBuf: $ui.get().pinBuf + String(k) });

  if ($ui.get().pinBuf.length === 4 && k !== "OK" && k !== "←") submitPin();
}

defineScreen("fridge-pin", (root) => {
  const lead = <p> { .className = "lead" }
  const dots = [];
  const dotsRow = <div> { .className = "dots" }
  for (let i = 0; i < 4; i++) {
    const dot = <span> {}
    dots.push(dot);
    [dotsRow] { [dot] }
  }
  const pad = <div> { .className = "pad" }
  for (const k of [1, 2, 3, 4, 5, 6, 7, 8, 9, "←", 0, "OK"]) {
    [pad] {
      <button> {
        .type = "button"
        [String(k)]
        .onclick = () => onKey(k)
      }
    }
  }
  const viewBtn = createViewButton();
  viewBtn.className = "pill view-corner";
  [root] {
    .className = "panel has-view"
    [viewBtn]
    <h2> { ["Parent Mode"] }
    [lead]
    [dotsRow]
    [pad]
    <div> {
      .className = "row"
      .style.marginTop = "18px"
      [Btn("Back to board", "btn ghost wide", () => {
        setUI({ view: "board", pinBuf: "" });
      })]
    }
  }

  function sync() {
    lead.textContent = $ui.get().pinMode === "set" ? "Choose a 4-digit PIN." : "Enter your PIN to unlock Parent Mode.";
    dots.forEach((dot, i) => {
      dot.className = i < $ui.get().pinBuf.length ? "full" : "";
    });
  }

  return sync;
}, [$ui]);
