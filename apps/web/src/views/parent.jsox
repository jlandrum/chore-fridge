import { openRewardForm as rewardForm } from "./reward-form.jsox";
import { COLORS, $familyName, setFamilyName, $kids, saveKid, removeKid, $requireParentModeForCompletion, setRequireParentModeForCompletion, $requireParentModeForRedemptions, setRequireParentModeForRedemptions, $mcpEnabled, setMcpEnabled, $sayings, setSayingsFromText, restoreDefaultSayings, $currencies } from "../stores/family.js";
import { currencyId, enabledCurrencies } from "@chore-fridge/domain/currencies";
import { CurrencyTab } from "./currency-settings.jsox";
import { formatSayingsText, parseSayingsText } from "@chore-fridge/domain/sayings";
import { $serverMode } from "../stores/sync.js";
import { $balances, amountForKid } from "../stores/balances.js";
import { $rewards, removeReward } from "../stores/rewards.js";
import { $ui, setUI, lockParent, closeSettings } from "../stores/navigation.js";
import { eraseBoard } from "../stores/setup.js";
import { updateList } from "../components/list.js";
import { Choices } from "../components/choices.jsox";
import { EmojiField } from "../components/emoji-field.jsox";
import { defineScreen } from "../components/screen.jsox";
import { Btn, showToast, openModal, closeModal, CurrencyMark } from "../ui.jsox";
import { TaskLists } from "./tasks.jsox";
import { openTaskForm } from "./task-form.jsox";
import { ViewControls } from "./view-options.jsox";
import { Tabs } from "../components/tabs.jsox";

function settingsIntro(title, lead, action) {
  return <div> {
    .className = "settings-intro"
    <div> {
      .className = "settings-intro-head"
      <h2> { [title] }
      [action]
    }
    <p> { .className = "lead"; [lead] }
  }
}

function kidForm(existing) {
  let color = existing ? existing.color : COLORS[$kids.get().length % COLORS.length];
  const nameInput = <input> {
    .value = existing ? existing.name : ""
    .autocomplete = "off"
  }
  const emoji = EmojiField(existing ? existing.emoji : "🐻", "🐻");
  const colorRow = Choices(
    COLORS.map((value) => ({ value, label: "●", color: value })),
    color, (value) => { color = value; }
  );

  openModal(
    <div> {
      <h3> { [existing ? "Edit kid" : "Add kid"] }
      <div> {
        .className = "row identity-row"
        <div> {
          .className = "field task-title"
          <label> { ["Name"] }
          [nameInput]
        }
        <div> {
          .className = "field task-emoji"
          <label> { ["Emoji"] }
          [emoji.trigger]
        }
      }
      <p> { .className = "view-label form-label"; ["Color"] }
      [colorRow]
      <div> {
        .className = "row"
        .style.marginTop = "16px"
        [Btn("Cancel", "btn ghost wide", closeModal)]
        [Btn("Save", "btn wide", () => {
          const name = nameInput.value.trim();
          if (!name) {
            showToast("Need a name");
            return;
          }
          saveKid({ id: existing?.id, name, emoji: emoji.value, color });
          closeModal();
        })]
      }
    }
  );
}


defineScreen("fridge-kid-settings", (root) => {
  const text = <div> { .className = "grow" }
  [root] {
    .className = "item"
    [text]
    [Btn("Edit", "tiny", () => kidForm(root.model))]
    [Btn("Remove", "tiny", () => {
      if (confirm("Remove this kid?")) removeKid(root.model.id);
    })]
  }
  return () => {
    const kid = root.model;
    text.replaceChildren(kid.emoji + " " + kid.name);
    for (const currency of enabledCurrencies($currencies.get())) {
      text.append(" · ", CurrencyMark(currency.id), " " + amountForKid(kid.id, currency.id));
    }
  };
}, [$balances, $currencies]);

defineScreen("fridge-kids-settings", (root) => {
  const list = <div> { .className = "list" }
  [root] {
    .className = "settings-page"
    [settingsIntro("Kids", "Manage the people who use this household board.", Btn("Add kid", "btn", () => kidForm(null)))]
    [list]
  }
  return () => updateList(list, $kids.get(), "fridge-kid-settings");
}, [$kids, $balances, $currencies]);

function KidsTab() { return <fridge-kids-settings> }

function ChoresTab() {
  return <div> {
    .className = "settings-page"
    [settingsIntro("Chores", "Manage every chore in one list. Its frequency appears beside its name.", Btn("Add", "btn", () => openTaskForm({repeat:"daily"})))]
    [TaskLists()]
  }
}

defineScreen("fridge-reward-settings", (root) => {
  const text = <div> { .className = "grow" }
  [root] {
    .className = "item"
    [text]
    [Btn("Edit", "tiny", () => rewardForm(root.model))]
    [Btn("Remove", "tiny", () => removeReward(root.model.id))]
  }
  return () => {
    const reward = root.model;
    text.replaceChildren(reward.emoji + " " + reward.title + " · ", CurrencyMark(currencyId(reward)), " " + reward.cost);
    if (reward.currencyExchange) text.append(" → ", CurrencyMark(reward.exchangeCurrency), " " + reward.exchangeValue);
    if (reward.oncePerDay) text.append(" · Once per child per day");
  };
});

defineScreen("fridge-rewards-settings", (root) => {
  const list = <div> { .className = "list" }
  [root] {
    .className = "settings-page"
    [settingsIntro("Rewards", "Create rewards kids can redeem with the credit they earn.", Btn("Add reward", "btn", () => rewardForm(null)))]
    [list]
  }
  return () => updateList(list, $rewards.get(), "fridge-reward-settings");
}, [$rewards]);

function RewardsTab() { return <fridge-rewards-settings> }

function permissionToggle(title, label, description, store, change) {
  const required = <input> {
    .type = "checkbox"
    .setAttribute("role", "switch")
    .setAttribute("aria-label", label)
    .onchange = () => change(required.checked)
  }
  const status = <span> { .className = "setting-status"; .setAttribute("aria-hidden", "true") }
  const node = <label> {
    .className = "setting-toggle"
    [required]
    <span> {
      .className = "setting-copy"
      <strong> { .className = "setting-title"; [title] }
      <span> { .className = "setting-description"; [description] }
    }
    <span> {
      .className = "setting-control"
      [status]
      <span> { .className = "switch-track"; .setAttribute("aria-hidden", "true") }
    }
  }
  return {node, sync() {
    const enabled = store.get();
    required.checked = enabled;
    required.setAttribute("aria-checked", String(enabled));
    status.textContent = enabled ? "On" : "Off";
  }};
}

function householdNameSetting() {
  const input = <input> {
    .id = "household-name"
    .type = "text"
    .maxlength = 300
    .autocomplete = "organization"
    .setAttribute("aria-label", "Household name")
  }
  const save = () => {
    const result = setFamilyName(input.value);
    if (result.error) { showToast(result.error); input.focus(); }
    else showToast("Household name saved.");
  };
  const node = <section> {
    .className = "settings-group"
    <h3> { ["Household"] }
    <form> {
      .className = "setting-form"
      .onsubmit = event => { event.preventDefault(); save(); }
      <label> { .className = "setting-title"; .htmlFor = "household-name"; ["Household name"] }
      <span> { .className = "setting-description"; ["Shown at the top of the board on every device."] }
      <span> { .className = "setting-input"; [input]; [Btn("Save", "btn", save)] }
    }
  }
  return {node, sync() {
    if (document.activeElement !== input) input.value = $familyName.get();
  }};
}

function shopSayingsSetting() {
  const input = <textarea> {
    .id = "shop-sayings"
    .rows = 12
    .setAttribute("aria-label", "Shop sayings")
    .setAttribute("spellcheck", "true")
  }
  const save = () => {
    const result = setSayingsFromText(input.value);
    if (result.error) { showToast(result.error); input.focus(); }
    else showToast(parseSayingsText(input.value).length ? "Shop sayings saved." : "Shop sayings cleared.");
  };
  const restore = () => {
    restoreDefaultSayings();
    input.value = formatSayingsText($sayings.get());
    showToast("Shop sayings restored.");
  };
  const node = <section> {
    .className = "settings-group"
    <h3> { ["Shop"] }
    <form> {
      .className = "setting-form"
      .onsubmit = event => { event.preventDefault(); save(); }
      <label> { .className = "setting-title"; .htmlFor = "shop-sayings"; ["Shop sayings"] }
      <span> { .className = "setting-description"; ["One saying per line. Slide to Buy shows one each day. Saved for the whole household."] }
      <span> {
        .className = "setting-input setting-sayings"
        [input]
        <span> {
          .className = "setting-sayings-actions"
          [Btn("Save sayings", "btn", save)]
          [Btn("Restore defaults", "btn ghost", restore)]
        }
      }
    }
  }
  return {node, sync() {
    if (document.activeElement !== input) input.value = formatSayingsText($sayings.get());
  }};
}

function settingsAction(heading, title, description, button) {
  return <section> {
    .className = "settings-group"
    <h3> { [heading] }
    <div> {
      .className = "setting-action"
      <span> {
        .className = "setting-copy"
        <strong> { .className = "setting-title"; [title] }
        <span> { .className = "setting-description"; [description] }
      }
      [button]
    }
  }
}

defineScreen("fridge-general-settings", (root) => {
  const permissions = [
    permissionToggle("Task changes", "Require Parent Mode for task changes", "Require Parent Mode to complete or undo tasks and change counts.", $requireParentModeForCompletion, setRequireParentModeForCompletion),
    permissionToggle("Reward redemptions", "Require Parent Mode for redemptions", "Require Parent Mode to redeem rewards with stars or gold.", $requireParentModeForRedemptions, setRequireParentModeForRedemptions),
  ];
  const permissionList = <div> { .className = "settings-stack" }
  permissions.forEach(permission => permissionList.append(permission.node));
  const householdName = householdNameSetting();
  const shopSayings = shopSayingsSetting();
  [root] {
    .className = "general-settings settings-page"
    <div> {
      .className = "settings-intro"
      <h2> { ["General"] }
      <p> { .className = "lead"; ["Manage how your household uses the board."] }
    }
  }
  root.append(
    <section> {
      .className = "settings-group"
      <h3> { ["Permissions"] }
      [permissionList]
    },
    householdName.node,
    shopSayings.node,
    settingsAction(
      "Parent Mode",
      "Parent PIN",
      "Change the four-digit PIN used to unlock Parent Mode on this household.",
      Btn("Change PIN", "btn ghost", () => setUI({pinMode:"set",pinBuf:"",view:"pin"}))
    ),
    settingsAction(
      "Danger zone",
      "Erase household",
      "Remove everyone, every task, every reward, and all household history.",
      Btn("Erase board and start over", "btn danger", () => {
        if (!confirm("Erase everyone and every chore?")) return;
        eraseBoard();
      })
    )
  );
  return () => {
    permissions.forEach(permission => permission.sync());
    householdName.sync();
    shopSayings.sync();
  };
}, [$familyName, $sayings, $requireParentModeForCompletion, $requireParentModeForRedemptions]);

function DisplayTab() {
  return <div> {
    .className = "settings-page"
    <div> {
      .className = "settings-intro"
      <h2> { ["Display"] }
      <p> { .className = "lead"; ["Adjust how the board looks and scales on this device."] }
    }
    [ViewControls()]
  }
}

function mcpEndpoint() {
  try { return new URL("/mcp", window.location.href).href; }
  catch { return "/mcp"; }
}

function mcpClientConfig(url) {
  return JSON.stringify({ mcpServers: { "chore-fridge": { url } } }, null, 2);
}

async function copyText(value) {
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      await navigator.clipboard.writeText(value);
      showToast("Copied");
      return;
    }
  } catch {}
  showToast("Select the text to copy");
}

defineScreen("fridge-advanced-settings", (root) => {
  const toggle = permissionToggle(
    "MCP",
    "Enable MCP",
    "Let local MCP clients read the board and send household commands through this server.",
    $mcpEnabled,
    setMcpEnabled
  );
  const urlInput = <input> {
    .readOnly = true
    .setAttribute("aria-label", "MCP URL")
  }
  const config = <pre> {}
  const warning = <p> { .className = "lead tight" }
  const details = <section> {
    .className = "settings-group mcp-connection"
    <h3> { ["Connection"] }
    <div> {
      .className = "setting-details"
      [warning]
      <p> { .className = "setting-description"; ["Streamable HTTP. Point an MCP client at this URL on the trusted LAN."] }
      <span> {
        .className = "setting-input"
        [urlInput]
        [Btn("Copy URL", "btn", () => copyText(urlInput.value))]
      }
      <strong> { .className = "setting-title"; ["Client config"] }
      [config]
      [Btn("Copy config", "btn", () => copyText(config.textContent))]
    }
  }
  [root] {
    .className = "settings-page"
    <div> {
      .className = "settings-intro"
      <h2> { ["Advanced"] }
      <p> { .className = "lead"; ["Optional integrations for this household server."] }
    }
    <section> {
      .className = "settings-group"
      <h3> { ["Integrations"] }
      <div> { .className = "settings-stack"; [toggle.node] }
    }
    [details]
  }
  return () => {
    toggle.sync();
    const enabled = $mcpEnabled.get();
    const url = mcpEndpoint();
    details.hidden = !enabled;
    urlInput.value = url;
    config.textContent = mcpClientConfig(url);
    warning.hidden = $serverMode.get();
    warning.textContent = $serverMode.get()
      ? ""
      : "This page is not connected to the household server, so clients cannot reach MCP until the Node service is running.";
  };
}, [$mcpEnabled, $serverMode]);

function AdvancedTab() { return <fridge-advanced-settings> }

function HelpTab() {
  return <div> {
    .className = "settings-page"
    <div> {
      .className = "settings-intro"
      <h2> { ["Help"] }
      <p> { .className = "lead"; ["Install Chore Fridge on a shared screen and keep the household service private."] }
    }
    <div> {
      .className = "help"
      <h3> { .className = "settings-label"; ["Put this on the fridge"] }
      <p> {
        <b> { ["Samsung Family Hub:"] }
        [" open the Internet app, type this page’s address, tap the star to bookmark, then tap the home-plus icon to pin it on a Family Hub board."]
      }
      <p> {
        <b> { ["iPad / Android tablet on the door:"] }
        [" open in the browser, Share → Add to Home Screen, then use Guided Access / pin app so kids cannot leave it."]
      }
      <p> {
        <b> { ["LG / other smart fridge browsers:"] }
        [" same idea — open the URL and bookmark it."]
      }
      <p> {
        <b> { ["Same Wi‑Fi:"] }
        [" if you ran the Docker image at home, use the computer’s private LAN address. Fridge and phones then share one list."]
      }
      <p> {
        <b> { ["Keep it private:"] }
        [" this app has no server authentication. Do not expose port 8080 to the internet; allow access only from devices on a trusted home network. Settings → Advanced can turn on MCP for local clients; it stays off until you enable it."]
      }
      <p> {
        ["Use Lock Parent Mode when you are finished. Returning to the board keeps settings unlocked on this page until you lock them or reload. Change the PIN in Settings → General while unlocked."]
      }
    }
  }
}

defineScreen("fridge-parent", (root) => {
  const tabOptions = ["general", "kids", "chores", "rewards", "currency", "display", "advanced", "help"].map(tab => ({
    value: tab,
    label: tab.charAt(0).toUpperCase() + tab.slice(1),
  }));
  const dismissSettings = () => {
    const settingsButton = root.parentElement?.querySelector("fridge-board .settings-button");
    closeSettings();
    queueMicrotask(() => settingsButton?.focus());
  };
  const tabs = Tabs(tabOptions, $ui.get().parentTab, tab => setUI({parentTab: tab}), {id:"settings-tabs", controls:"settings-panel", className:"tabs settings-nav"});
  const body = <div> { .id = "settings-panel"; .className = "settings-body"; .setAttribute("role", "tabpanel") }
  const close = Btn("Close", "btn ghost settings-close", dismissSettings);
  [root] {
    .className = "settings-modal"
    .setAttribute("role", "dialog")
    .setAttribute("aria-modal", "true")
    .setAttribute("aria-labelledby", "settings-title")
    .onclick = event => { if (event.target === root) dismissSettings(); }
    .onkeydown = event => { if (event.key === "Escape") dismissSettings(); }
    <section> {
      .className = "panel settings-panel"
      <header> {
        .className = "settings-header"
        <h1> { .id = "settings-title"; ["Settings"] }
        <div> {
          .className = "row"
          [Btn("Lock Parent Mode", "btn ghost", lockParent)]
          [close]
        }
      }
      <div> {
        .className = "settings-layout"
        [tabs]
        [body]
      }
    }
  }

  const factories = { general: () => <fridge-general-settings>, kids: KidsTab, chores: ChoresTab, rewards: RewardsTab, currency: CurrencyTab, display: DisplayTab, advanced: AdvancedTab, help: HelpTab };
  const pages = new Map();
  let currentTab;
  function sync() {
    const selected = $ui.get().parentTab;
    tabs.value = selected;
    tabs.update();
    body.setAttribute("aria-labelledby", "settings-tabs-" + selected);
    if (currentTab === selected) return;
    currentTab = selected;
    if (!pages.has(currentTab)) pages.set(currentTab, (factories[currentTab] || HelpTab)());
    body.replaceChildren(pages.get(currentTab));
  }

  return sync;
}, [$ui]);
