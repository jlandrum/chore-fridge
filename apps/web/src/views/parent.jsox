import { COLORS, KID_EMOJIS, $familyName, setFamilyName, $kids, saveKid, removeKid, $requireParentModeForCompletion, setRequireParentModeForCompletion, $requireParentModeForRedemptions, setRequireParentModeForRedemptions } from "../stores/family.js";
import { $balances, starsFor, goldFor } from "../stores/balances.js";
import { $rewards, saveReward, removeReward } from "../stores/rewards.js";
import { $ui, setUI, lockParent, closeSettings } from "../stores/navigation.js";
import { eraseBoard } from "../stores/setup.js";
import { uid } from "@chore-fridge/domain/records";
import { updateList } from "../components/list.js";
import { Choices } from "../components/choices.jsox";
import { defineScreen } from "../components/screen.jsox";
import { Btn, showToast, openModal, closeModal, Star } from "../ui.jsox";
import { TaskLists } from "./tasks.jsox";
import { ViewControls } from "./view-options.jsox";
import { Tabs } from "../components/tabs.jsox";

function kidForm(existing) {
  let emoji = existing ? existing.emoji : "🐻";
  let color = existing ? existing.color : COLORS[$kids.get().length % COLORS.length];
  const nameInput = <input> {
    .value = existing ? existing.name : ""
    .autocomplete = "off"
  }

  const emojiRow = Choices(
    KID_EMOJIS.map((value) => ({ value, label: value })),
    emoji, (value) => { emoji = value; }
  );
  const colorRow = Choices(
    COLORS.map((value) => ({ value, label: "●", color: value })),
    color, (value) => { color = value; }
  );

  openModal(
    <div> {
      <h3> { [existing ? "Edit kid" : "Add kid"] }
      <div> {
        .className = "field"
        <label> { ["Name"] }
        [nameInput]
      }
      <p> { .className = "view-label form-label"; ["Avatar"] }
      [emojiRow]
      <p> { .className = "view-label form-label"; ["Color"] }
      [colorRow]
      <div> {
        .className = "row"
        .style.marginTop = "16px"
        [Btn("Cancel", "btn ghost wide", closeModal)]
        [Btn("Save", "btn wide", () => {
          const name = nameInput.value.trim();
          if (!name) {
            showToast("Need a name");
            return;
          }
          saveKid({ id: existing?.id, name, emoji, color });
          closeModal();
        })]
      }
    }
  );
}

function rewardForm(existing) {
  const titleInput = <input> {
    .value = existing ? existing.title : ""
    .autocomplete = "off"
  }
  const emojiInput = <input> {
    .value = existing ? existing.emoji : ""
    .placeholder = "🎁"
    .title = "Type or paste any emoji"
    .autocomplete = "off"
    .spellcheck = false
  }
  const costInput = <input> {
    .value = existing ? String(existing.cost) : "20"
    .autocomplete = "off"
  }
  let gold = !!(existing && existing.gold);
  const goldBtn = <button> {
    .type = "button"
    .className = gold ? "choice on" : "choice"
    ["Gold star reward"]
    .onclick = () => {
      gold = !gold;
      goldBtn.className = gold ? "choice on" : "choice";
    }
  }
  openModal(
    <div> {
      <h3> { [existing ? "Edit reward" : "Add reward"] }
      <div> {
        .className = "field"
        <label> { ["Reward"] }
        [titleInput]
      }
      <div> {
        .className = "field"
        <label> { ["Emoji"] }
        [emojiInput]
      }
      <div> {
        .className = "field"
        <label> { ["Cost"] }
        [costInput]
      }
      <p> { .className = "lead"; ["Gold rewards spend gold stars instead of regular stars."] }
      <div> {
        .className = "row"
        [goldBtn]
      }
      <div> {
        .className = "row"
        .style.marginTop = "16px"
        [Btn("Cancel", "btn ghost wide", closeModal)]
        [Btn("Save", "btn wide", () => {
          const title = titleInput.value.trim();
          if (!title) {
            showToast("Need a name");
            return;
          }
          const payload = {
            id: existing ? existing.id : uid(),
            title,
            emoji: emojiInput.value.trim() || "🎁",
            cost: Math.max(1, parseInt(costInput.value, 10) || 1),
            gold,
          };
          saveReward(payload);
          closeModal();
        })]
      }
    }
  );
}

defineScreen("fridge-kid-settings", (root) => {
  const text = <div> { .className = "grow" }
  [root] {
    .className = "item"
    [text]
    [Btn("Edit", "tiny", () => kidForm(root.model))]
    [Btn("Remove", "tiny", () => {
      if (confirm("Remove this kid?")) removeKid(root.model.id);
    })]
  }
  return () => {
    const kid = root.model;
    const gold = goldFor(kid.id);
    text.replaceChildren(kid.emoji + " " + kid.name + " · ", Star(false), " " + starsFor(kid.id));
    if (gold) text.append(" · ", Star(true), " " + gold);
  };
});

defineScreen("fridge-kids-settings", (root) => {
  const list = <div> { .className = "list" }
  [root] {
    <h2> { ["Kids"] }
    <p> { .className = "lead"; ["Manage the people who use this household board."] }
    [list]
    [Btn("Add kid", "btn", () => kidForm(null))]
  }
  return () => updateList(list, $kids.get(), "fridge-kid-settings");
}, [$kids, $balances]);

function KidsTab() { return <fridge-kids-settings> }

function ChoresTab() {
  return <div> {
    <h2> { ["Chores"] }
    <p> {
      .className = "lead"
      ["Manage every chore in one list. Its frequency appears beside its name."]
    }
    [TaskLists()]
  }
}

defineScreen("fridge-reward-settings", (root) => {
  const text = <div> { .className = "grow" }
  [root] {
    .className = "item"
    [text]
    [Btn("Edit", "tiny", () => rewardForm(root.model))]
    [Btn("Remove", "tiny", () => removeReward(root.model.id))]
  }
  return () => {
    const reward = root.model;
    text.replaceChildren(reward.emoji + " " + reward.title + " · ", Star(!!reward.gold), " " + reward.cost);
  };
});

defineScreen("fridge-rewards-settings", (root) => {
  const list = <div> { .className = "list" }
  [root] {
    <h2> { ["Rewards"] }
    <p> { .className = "lead"; ["Create rewards kids can redeem with the credit they earn."] }
    [list]
    [Btn("Add reward", "btn", () => rewardForm(null))]
  }
  return () => updateList(list, $rewards.get(), "fridge-reward-settings");
}, [$rewards]);

function RewardsTab() { return <fridge-rewards-settings> }

function permissionToggle(title, label, description, store, change) {
  const required = <input> {
    .type = "checkbox"
    .setAttribute("role", "switch")
    .setAttribute("aria-label", label)
    .onchange = () => change(required.checked)
  }
  const status = <span> { .className = "setting-status"; .setAttribute("aria-hidden", "true") }
  const node = <label> {
    .className = "setting-toggle"
    [required]
    <span> {
      .className = "setting-copy"
      <strong> { .className = "setting-title"; [title] }
      <span> { .className = "setting-description"; [description] }
    }
    <span> {
      .className = "setting-control"
      [status]
      <span> { .className = "switch-track"; .setAttribute("aria-hidden", "true") }
    }
  }
  return {node, sync() {
    const enabled = store.get();
    required.checked = enabled;
    required.setAttribute("aria-checked", String(enabled));
    status.textContent = enabled ? "On" : "Off";
  }};
}

function householdNameSetting() {
  const input = <input> {
    .id = "household-name"
    .type = "text"
    .maxlength = 300
    .autocomplete = "organization"
    .setAttribute("aria-label", "Household name")
  }
  const save = () => {
    const result = setFamilyName(input.value);
    if (result.error) { showToast(result.error); input.focus(); }
    else showToast("Household name saved.");
  };
  const node = <section> {
    .className = "settings-group"
    <h3> { ["Household"] }
    <form> {
      .className = "setting-form"
      .onsubmit = event => { event.preventDefault(); save(); }
      <label> { .className = "setting-title"; .htmlFor = "household-name"; ["Household name"] }
      <span> { .className = "setting-description"; ["Shown at the top of the board on every device."] }
      <span> { .className = "setting-input"; [input]; [Btn("Save", "btn", save)] }
    }
  }
  return {node, sync() {
    if (document.activeElement !== input) input.value = $familyName.get();
  }};
}

function settingsAction(heading, title, description, button) {
  return <section> {
    .className = "settings-group"
    <h3> { [heading] }
    <div> {
      .className = "setting-action"
      <span> {
        .className = "setting-copy"
        <strong> { .className = "setting-title"; [title] }
        <span> { .className = "setting-description"; [description] }
      }
      [button]
    }
  }
}

defineScreen("fridge-general-settings", (root) => {
  const permissions = [
    permissionToggle("Task changes", "Require Parent Mode for task changes", "Require Parent Mode to complete or undo tasks and change counts.", $requireParentModeForCompletion, setRequireParentModeForCompletion),
    permissionToggle("Reward redemptions", "Require Parent Mode for redemptions", "Require Parent Mode to redeem rewards with stars or gold.", $requireParentModeForRedemptions, setRequireParentModeForRedemptions),
  ];
  const permissionList = <div> { .className = "settings-stack" }
  permissions.forEach(permission => permissionList.append(permission.node));
  const householdName = householdNameSetting();
  [root] {
    .className = "general-settings"
    <h2> { ["General"] }
    <p> { .className = "lead"; ["Manage how your household uses the board."] }
  }
  root.append(
    <section> {
      .className = "settings-group"
      <h3> { ["Permissions"] }
      [permissionList]
    },
    householdName.node,
    settingsAction(
      "Parent Mode",
      "Parent PIN",
      "Change the four-digit PIN used to unlock Parent Mode on this household.",
      Btn("Change PIN", "btn ghost", () => setUI({pinMode:"set",pinBuf:"",view:"pin"}))
    ),
    settingsAction(
      "Danger zone",
      "Erase household",
      "Remove everyone, every task, every reward, and all household history.",
      Btn("Erase board and start over", "btn danger", () => {
        if (!confirm("Erase everyone and every chore?")) return;
        eraseBoard();
      })
    )
  );
  return () => {
    permissions.forEach(permission => permission.sync());
    householdName.sync();
  };
}, [$familyName, $requireParentModeForCompletion, $requireParentModeForRedemptions]);

function DisplayTab() {
  return <div> {
    <h2> { ["Display"] }
    <p> { .className = "lead"; ["Adjust how the board looks and scales on this device."] }
    [ViewControls()]
  }
}

function HelpTab() {
  return <div> {
    <h2> { ["Help"] }
    <p> { .className = "lead"; ["Install Chore Fridge on a shared screen and keep the household service private."] }
    <div> {
      .className = "help"
      <h3> { .className = "settings-label"; ["Put this on the fridge"] }
      <p> {
        <b> { ["Samsung Family Hub:"] }
        [" open the Internet app, type this page’s address, tap the star to bookmark, then tap the home-plus icon to pin it on a Family Hub board."]
      }
      <p> {
        <b> { ["iPad / Android tablet on the door:"] }
        [" open in the browser, Share → Add to Home Screen, then use Guided Access / pin app so kids cannot leave it."]
      }
      <p> {
        <b> { ["LG / other smart fridge browsers:"] }
        [" same idea — open the URL and bookmark it."]
      }
      <p> {
        <b> { ["Same Wi‑Fi:"] }
        [" if you ran the Docker image at home, use the computer’s private LAN address. Fridge and phones then share one list."]
      }
      <p> {
        <b> { ["Keep it private:"] }
        [" this app has no server authentication. Do not expose port 8080 to the internet; allow access only from devices on a trusted home network."]
      }
      <p> {
        ["Use Lock Parent Mode when you are finished. Returning to the board keeps settings unlocked on this page until you lock them or reload. Change the PIN in Settings → General while unlocked."]
      }
    }
  }
}

defineScreen("fridge-parent", (root) => {
  const tabOptions = ["general", "kids", "chores", "rewards", "display", "help"].map(tab => ({
    value: tab,
    label: tab.charAt(0).toUpperCase() + tab.slice(1),
  }));
  const dismissSettings = () => {
    const settingsButton = root.parentElement?.querySelector("fridge-board .settings-button");
    closeSettings();
    queueMicrotask(() => settingsButton?.focus());
  };
  const tabs = Tabs(tabOptions, $ui.get().parentTab, tab => setUI({parentTab: tab}), {id:"settings-tabs", controls:"settings-panel"});
  const body = <div> { .id = "settings-panel"; .className = "settings-body"; .setAttribute("role", "tabpanel") }
  const close = Btn("Close", "btn ghost settings-close", dismissSettings);
  [root] {
    .className = "settings-modal"
    .setAttribute("role", "dialog")
    .setAttribute("aria-modal", "true")
    .setAttribute("aria-labelledby", "settings-title")
    .onclick = event => { if (event.target === root) dismissSettings(); }
    .onkeydown = event => { if (event.key === "Escape") dismissSettings(); }
    <section> {
      .className = "panel settings-panel"
      <header> {
        .className = "settings-header"
        <h1> { .id = "settings-title"; ["Settings"] }
        <div> {
          .className = "row"
          [Btn("Lock Parent Mode", "btn ghost", lockParent)]
          [close]
        }
      }
      [tabs]
      [body]
    }
  }

  const factories = { general: () => <fridge-general-settings>, kids: KidsTab, chores: ChoresTab, rewards: RewardsTab, display: DisplayTab, help: HelpTab };
  const pages = new Map();
  let currentTab;
  function sync() {
    const selected = $ui.get().parentTab;
    tabs.value = selected;
    tabs.update();
    body.setAttribute("aria-labelledby", "settings-tabs-" + selected);
    if (currentTab === selected) return;
    currentTab = selected;
    if (!pages.has(currentTab)) pages.set(currentTab, (factories[currentTab] || HelpTab)());
    body.replaceChildren(pages.get(currentTab));
  }

  return sync;
}, [$ui]);
