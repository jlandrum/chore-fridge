import { $kids } from "../stores/family.js";
import { $chores, choreKind, minCount, maxCount, isCounted, removeChore, $archivedChores, restoreChore } from "../stores/chores.js";
import { defineScreen } from "../components/screen.jsox";
import { updateList } from "../components/list.js";
import { Btn, showToast, Star } from "../ui.jsox";
import { openTaskForm } from "./task-form.jsox";

function kidNames(chore) {
  return (chore.kidIds || []).map((id) => {
    const kid = $kids.get().find((item) => item.id === id);
    return kid ? kid.emoji + " " + kid.name : "";
  }).filter(Boolean).join(" · ");
}

defineScreen("fridge-task-summary", (root) => {
  const title = <div> {}
  const sub = <div> { .className = "sub" }
  [root] {
    .className = "item"
    <div> { .className = "grow"; [title]; [sub] }
    [Btn("Edit", "tiny", () => openTaskForm({ existing: root.model }))]
    [Btn("Archive", "tiny", () => {
      const chore = root.model;
      if (!confirm("Archive this " + choreKind(chore).toLowerCase() + " task?")) return;
      removeChore(chore.id);
      showToast("Archived");
    })]
  }
  return () => {
    const chore = root.model;
    title.textContent = chore.title + " · " + choreKind(chore);
    sub.replaceChildren(kidNames(chore) || "Nobody assigned");
    if (chore.gold) sub.append(" · ", Star(true), " gold");
    if (isCounted(chore)) sub.append(" · " + minCount(chore) + "–" + maxCount(chore) + " / day");
  };
});

defineScreen("fridge-archived-task", (root) => {
  const title = <div> { .className = "grow" }
  [root] {
    .className = "item"
    [title]
    [Btn("Restore", "tiny", () => restoreChore(root.model.id))]
  }
  return () => { title.textContent = root.model.title; };
});

defineScreen("fridge-task-lists", (root) => {
  const list = <div> { .className = "list" }
  const empty = <div> { .className = "empty-line"; ["No chores yet."] }
  const archivedList = <div> { .className = "list" }
  const archivedSection = <section> {
    .className = "task-section"
    <h3> { .className = "settings-label"; ["Archived chores"] }
    <p> { .className = "lead tight"; ["Past completions and earned credits are kept. Restore a task to use it again."] }
    [archivedList]
  }
  [root] {
    <div> { .className = "task-actions"; [Btn("Add", "btn", () => openTaskForm({repeat:"daily"}))] }
    [list]
    [empty]
    [archivedSection]
  }
  return () => {
    const chores = $chores.get();
    updateList(list, chores, "fridge-task-summary");
    empty.hidden = !!chores.length;
    archivedSection.hidden = !$archivedChores.get().length;
    updateList(archivedList,$archivedChores.get(),"fridge-archived-task");
  };
}, [$kids, $chores, $archivedChores]);

export function TaskLists() { return <fridge-task-lists> }
