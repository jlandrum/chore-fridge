import { $currencies } from "../stores/family.js";
import { saveReward } from "../stores/rewards.js";
import { currencyId, enabledCurrencies, currencyById } from "@chore-fridge/domain/currencies";
import { rewardCosts } from "@chore-fridge/domain/rewards";
import { Choices } from "../components/choices.jsox";
import { EmojiField } from "../components/emoji-field.jsox";
import { formToggle } from "../components/form-toggle.jsox";
import { Tabs } from "../components/tabs.jsox";
import { Btn, showToast, openModal, closeModal } from "../ui.jsox";

export function openRewardForm(existing = null) {
  let exchangeCurrency = existing?.exchangeCurrency || "dollar";
  let selected = "general";
  const titleInput = <input> { .value = existing?.title || ""; .autocomplete = "off"; .setAttribute("aria-label", "Reward") }
  const emoji = EmojiField(existing?.emoji || "🎁", "🎁");
  const valueInput = <input> { .type = "number"; .min = "1"; .step = "1"; .value = String(existing?.exchangeValue || 5); .setAttribute("aria-label", "Payout value") }
  const options = enabledCurrencies($currencies.get()).map(item => ({value:item.id,label:item.name}));
  const lines = rewardCosts(existing).map((row) => ({currency: row.currency, amount: row.amount}));
  if (!lines.length) lines.push({currency: currencyId(existing), amount: existing?.cost || 20});
  for (const id of [...lines.map((line) => line.currency), exchangeCurrency]) {
    if (!options.some(item => item.value === id)) options.push({value:id,label:currencyById($currencies.get(), id).name});
  }
  const exchangeChoices = Choices(options, exchangeCurrency, value => { exchangeCurrency = value; }, {className:"row task-currency"});
  const costList = <div> { .className = "cost-lines" }
  function usedCurrencies(skip) {
    return new Set(lines.map((line, index) => index === skip ? null : line.currency).filter(Boolean));
  }
  function readLines() {
    for (const line of lines) {
      if (line.input) line.amount = Number(line.input.value) || line.amount;
    }
  }
  function renderCosts() {
    readLines();
    costList.replaceChildren();
    lines.forEach((line, index) => {
      const labelText = index === 0 ? "Cost" : "Cost " + (index + 1);
      const amountInput = <input> {
        .type = "number"
        .min = "1"
        .step = "1"
        .value = String(line.amount || 1)
        .setAttribute("aria-label", labelText)
        .oninput = () => { line.amount = Number(amountInput.value); }
      }
      line.input = amountInput;
      const available = options.filter((item) => item.value === line.currency || !usedCurrencies(index).has(item.value));
      const select = <select> {
        .setAttribute("aria-label", labelText + " currency")
        .onchange = () => { line.currency = select.value; renderCosts(); }
      }
      for (const item of available) {
        const option = document.createElement("option");
        option.value = item.value;
        option.textContent = item.label;
        if (item.value === line.currency) option.selected = true;
        select.append(option);
      }
      const minus = Btn("−", "tiny cost-remove", () => { if (lines.length < 2) return; lines.splice(index, 1); renderCosts(); });
      minus.setAttribute("aria-label", "Remove " + labelText);
      minus.disabled = lines.length < 2;
      const row = <div> {
        .className = "cost-line"
        [select]
        <div> { .className = "field"; <label> { [labelText] }; [amountInput] }
        [minus]
      }
      costList.append(row);
    });
  }
  renderCosts();
  const addCost = Btn("+", "tiny cost-add", () => {
    const used = usedCurrencies(-1);
    const next = options.find((item) => !used.has(item.value));
    if (!next) { showToast("Every currency is already on this reward"); return; }
    lines.push({currency: next.value, amount: 1});
    renderCosts();
  });
  addCost.setAttribute("aria-label", "Add currency");
  const family = formToggle("Family reward", "Anyone can chip in toward this cost. It is redeemed when the payments reach the cost.", "Family reward", existing?.pooled, (on) => { if (on) exchange.set(false); updateTabs(); });
  const exchange = formToggle("Currency Exchange", "Give another currency when this reward is redeemed.", "Currency Exchange", existing?.currencyExchange && !existing?.pooled, () => updateTabs());
  const daily = formToggle("Only allow one redemption per day", "Each child can redeem this once per calendar day. A family reward can be completed once per day for the whole household.", "Only allow one redemption per day", existing?.oncePerDay);
  const general = <div> {
    .className = "task-panel"
    <div> {
      .className = "row identity-row"
      <div> { .className = "field task-title"; <label> { ["Reward"] }; [titleInput] }
      <div> { .className = "field task-emoji"; <label> { ["Emoji"] }; [emoji.trigger] }
    }
    <p> { .className = "view-label"; ["Cost"] }
    [costList]
    [addCost]
  }
  const advanced = <div> {
    .className = "task-panel"
    <h4> { ["Advanced"] }
    <div> { .className = "settings-stack"; [family.node]; [exchange.node]; [daily.node] }
  }
  const payout = <div> {
    .className = "task-panel"
    <h4> { ["Currency Exchange"] }
    <p> { .className = "lead"; ["The cost on General is deducted and this amount is added to the child’s balance. For example: spend 100 Stars to receive 5 Dollars."] }
    <p> { .className = "view-label"; ["Currency to receive"] }
    [exchangeChoices]
    <div> { .className = "field"; <label> { ["Payout value"] }; [valueInput] }
  }
  const panels = {general, advanced, exchange:payout};
  const fields = <div> { .id = "reward-form-panel"; .className = "task-form-fields"; .setAttribute("role", "tabpanel"); [general]; [advanced]; [payout] }
  const tabHost = <div> { .className = "task-form-tabhost" }
  function showPanel(value) {
    selected = value;
    for (const [name, panel] of Object.entries(panels)) panel.hidden = name !== value;
    fields.setAttribute("aria-labelledby", "reward-form-tabs-" + value);
  }
  function updateTabs() {
    if (family.get()) exchange.set(false);
    exchange.node.hidden = family.get();
    if (!exchange.get() && selected === "exchange") selected = "advanced";
    const tabs = [{value:"general",label:"General"},{value:"advanced",label:"Advanced"}];
    if (exchange.get()) tabs.push({value:"exchange",label:"Currency Exchange"});
    tabHost.replaceChildren(Tabs(tabs, selected, showPanel, {id:"reward-form-tabs",controls:"reward-form-panel",className:"tabs task-form-tabs",orientation:"vertical"}));
    showPanel(selected);
  }
  const sheet = <div> {
    .className = "task-form reward-form"
    <h3> { [existing ? "Edit reward" : "Add reward"] }
    <div> { .className = "task-form-layout"; [tabHost]; [fields] }
    <div> {
      .className = "row task-form-actions"
      [Btn("Cancel", "btn ghost wide", closeModal)]
      [Btn("Save", "btn wide", () => {
        const title = titleInput.value.trim();
        if (!title) { showToast("Need a name"); return; }
        const pooled = family.get();
        const exchanging = !pooled && exchange.get();
        const costs = lines.map((line) => ({currency: line.currency, amount: Number(line.input ? line.input.value : line.amount)}));
        const payload = {id:existing?.id,title,emoji:emoji.value,cost:costs[0]?.amount,currency:costs[0]?.currency,gold:costs[0]?.currency === "gold",costs,pooled,currencyExchange:exchanging,oncePerDay:daily.get()};
        if (exchanging) { payload.exchangeCurrency = exchangeCurrency; payload.exchangeValue = Number(valueInput.value); }
        const result = saveReward(payload);
        if (result?.error) { showToast(result.error); return; }
        closeModal();
        if (result?.completed) showToast(title + " is paid for.");
      })]
    }
  }
  openModal(sheet);
  updateTabs();
}
